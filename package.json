{
  "name": "creatorops-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm build && pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:db": "bash scripts/pg-local.sh start",
    "dev:db:stop": "bash scripts/pg-local.sh stop",
    "dev:redis": "bash scripts/redis-local.sh start",
    "dev:redis:stop": "bash scripts/redis-local.sh stop",
    "dev:worker": "pnpm build && pnpm --filter @creatorops/api worker",
    "dev:db:compose": "docker compose -f infra/docker/docker-compose.yml up -d postgres",
    "db:generate": "pnpm --filter @creatorops/api db:generate",
    "db:migrate": "pnpm build && pnpm --filter @creatorops/api db:migrate",
    "db:seed": "pnpm build && pnpm --filter @creatorops/api db:seed",
    "e2e": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present e2e",
    "demo": "node scripts/demo.mjs",
    "eval:text": "node scripts/eval-text.mjs",
    "prompts:video": "node scripts/video-prompts.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
