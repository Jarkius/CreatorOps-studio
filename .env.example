# CreatorOps Studio environment variables (planned).
# Copy this file to .env and fill in real values. Real .env files are git-ignored.
# Placeholder values only. Never commit real secrets.
#
# DATABASE_URL: PostgreSQL connection string used by the API (Phase 1).
# DATABASE_URL=postgres://creatorops:change-me@localhost:5432/creatorops
#
# AUTH_MODE: authentication mode for the API; "mock" until real auth exists (Phase 1).
# AUTH_MODE=mock
#
# API_BASE_URL: public base URL of the API, used by the dashboard and extension (Phase 1).
# API_BASE_URL=http://localhost:3000
#
# WEB_ORIGIN: origin of the web dashboard allowed by CORS (Phase 1).
# WEB_ORIGIN=http://localhost:5173
#
# EXTENSION_ORIGIN: origin of the Chrome extension allowed by CORS (Phase 1).
# EXTENSION_ORIGIN=chrome-extension://<the 32-letter extension id>
#
# SESSION_SECRET: secret used to sign sessions; must be replaced with a long random value (Phase 1).
# SESSION_SECRET=change-me
#
# HOST: interface the API listens on. Loopback by default; use 0.0.0.0 only deliberately (containers).
# HOST=127.0.0.1
#
# PORT: API port (default 3000).
# PORT=3000
#
# RATE_LIMIT_MAX: requests per minute per client address (default 300).
# RATE_LIMIT_MAX=300
