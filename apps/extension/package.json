{
  "name": "@creatorops/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.json && vite build",
    "build:store": "tsc -p tsconfig.json && vite build --mode store",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "e2e": "node ../../scripts/e2e-db.mjs && tsc -p tsconfig.json && E2E_GRANT_META_AI=1 VITE_AUTH_MODE=mock VITE_API_BASE_URL=http://localhost:3000 vite build && playwright test"
  },
  "dependencies": {
    "@creatorops/contracts": "workspace:*",
    "@creatorops/ui": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
