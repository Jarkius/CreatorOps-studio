{
  "name": "@creatorops/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "e2e": "VITE_AUTH_MODE=mock VITE_API_BASE_URL=http://localhost:3000 vite build && playwright test"
  },
  "dependencies": {
    "@creatorops/contracts": "workspace:*",
    "@creatorops/ui": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
